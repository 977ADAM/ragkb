# Обязательные для `docker compose up` (make up). Для `make backend` не нужны.
POSTGRES_USER=ragkb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragkb
# Хост БД в compose — имя сервиса.
POSTGRES_HOST=postgres

# OpenAI-совместимый HTTP (vLLM, llama.cpp, LM Studio…).
# Без адреса compose поднимется, но генерация не заработает.
RAGKB_LLM_URL=http://127.0.0.1:8080/v1

# Администратор (8–128 символов). Оба пустые — сидер пропускается.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-admin
