# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.

MARIADB_ROOT_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_HOSTNAME=kb.example.local
KEYCLOAK_ISSUER_URL=https://kb.example.local:8443/realms/company

OAUTH2_CLIENT_SECRET=
# Сгенерировать:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
OAUTH2_COOKIE_SECRET=
OAUTH2_REDIRECT_URL=https://kb.example.local/oauth2/callback

# Сеть, из которой прокси доверяет заголовкам X-Forwarded-*.
# Требуется после исправления CVE-2026-40575.
TRUSTED_PROXY_IP=127.0.0.1/32
