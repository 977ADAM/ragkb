# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.

POSTGRES_USER=ragkb
POSTGRES_PASSWORD=
POSTGRES_DB=ragkb
RAGKB_DATABASE_URL=postgresql+asyncpg://ragkb:CHANGEME@postgres:5432/ragkb

# Compose по умолчанию: сессия (формы /login и /register). Keycloak и Angie OIDC
# для ragkb больше не источник личности — только кука после регистрации в UI.
RAGKB_AUTH_MODE=session

# RAGKB_DEV_USER не заменяет сессию при session. На сервере не задавать.
# (Режим proxy / локальный BFF без форм — отдельно.)
# RAGKB_DEV_USER=dev
# RAGKB_DEV_GROUPS=ragkb-users,ragkb-admins

# --- LLM: любой OpenAI-совместимый HTTP (обычно корень …/v1) ---
# RAGKB_LLM_URL=http://10.10.1.114:8080/v1
# RAGKB_LLM_MODEL=qwen2.5-instruct
# RAGKB_LLM_API_KEY=
# RAGKB_LLM_BACKEND=openai
#
# Эмбеддинги — HuggingFace в контейнере rag (не llama.cpp на :8080).
# RAGKB_EMBEDDING_BACKEND=sentence-transformers
# RAGKB_EMBEDDING_MODEL=BAAI/bge-m3

# Журналы процесса rag (файлы app.log / errors.log). Пустой RAGKB_LOG_DIR — только stdout.
# RAGKB_LOG_LEVEL=INFO
# RAGKB_LOG_DIR=data/logs
