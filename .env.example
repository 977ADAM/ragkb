# Пример для docker compose up (make up). Локальный запуск с SQLite — в README.
# Локально адреса моделей и остальные RAGKB_* нужно экспортировать в окружение.
POSTGRES_USER=ragkb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragkb
# Хост БД в compose — имя сервиса.
POSTGRES_HOST=postgres

# Эмбеддинги считает Ollama на хосте — модель в образ rag не входит.
# Перед первым запуском: ollama pull qwen3-embedding:0.6b
# host.docker.internal — хост-машина из контейнера (extra_hosts уже задан).
RAGKB_EMBEDDING_BACKEND=ollama
RAGKB_EMBEDDING_MODEL=qwen3-embedding:0.6b
RAGKB_EMBEDDING_URL=http://host.docker.internal:11434
# Держать модель загруженной между индексацией и вопросами.
RAGKB_EMBEDDING_KEEP_ALIVE=30m

# Для сохранения настроек при пересоздании контейнера добавьте том
# по примеру Compose override в README, затем задайте:
# RAGKB_SETTINGS_FILE=/app/data/config/settings.json

# Генерация — обязательна: OpenAI-совместимый HTTP (vLLM, llama.cpp, LM Studio…).
# Подойдёт и сама Ollama: укажите её корень с /v1.
# Без адреса генерации POST /api/v1/ask отвечает 503, экстрактивного ответа нет.
# Модель должна быть установлена: ollama pull qwen2.5:7b-instruct
RAGKB_LLM_URL=http://host.docker.internal:11434/v1
RAGKB_LLM_MODEL=qwen2.5:7b-instruct
