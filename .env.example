# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.

MARIADB_ROOT_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Одно и то же имя хоста во всех переменных ниже (KEYCLOAK_HOSTNAME,
# KEYCLOAK_HOSTNAME_URL, KEYCLOAK_ISSUER_URL, OAUTH2_REDIRECT_URL) — это
# условие развёртывания: имя должно резолвиться в адрес хоста через
# корпоративный DNS или запись в /etc/hosts, иначе браузер и oauth2-proxy
# не попадут в Keycloak.
# KEYCLOAK_HOSTNAME — голое имя, используется как алиас в сети compose.
KEYCLOAK_HOSTNAME=kb.example.local
# KEYCLOAK_HOSTNAME_URL — то же имя, но с явной схемой и портом: значение
# идёт в KC_HOSTNAME (hostname v2), и без явного порта Keycloak подразумевает
# стандартные 443/80, а не 8443 — issuer в токене разойдётся с
# KEYCLOAK_ISSUER_URL, и discovery прокси упадёт при старте.
KEYCLOAK_HOSTNAME_URL=https://kb.example.local:8443
KEYCLOAK_ISSUER_URL=https://kb.example.local:8443/realms/company

OAUTH2_CLIENT_SECRET=
# Сгенерировать:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
OAUTH2_COOKIE_SECRET=
OAUTH2_REDIRECT_URL=https://kb.example.local/oauth2/callback

# Каталог ./certs монтируется в keycloak и proxy и должен содержать:
#   tls.crt, tls.key — серверный сертификат (внутренний УЦ или самоподписанный)
#   ca.crt           — корневой сертификат этого УЦ; им proxy проверяет
#                       сертификат Keycloak при discovery
# (см. --provider-ca-file в docker-compose.yml).

# --- Модели: любой OpenAI-совместимый HTTP (обычно корень …/v1) ---
# RAGKB_LLM_URL=http://10.10.1.114:8080/v1
# RAGKB_LLM_MODEL=qwen2.5-instruct
# RAGKB_LLM_API_KEY=
# RAGKB_LLM_BACKEND=openai
# RAGKB_EMBEDDING_URL=http://10.10.1.114:8080/v1
# RAGKB_EMBEDDING_MODEL=bge-m3
# RAGKB_EMBEDDING_API_KEY=
# RAGKB_EMBEDDING_BACKEND=openai
