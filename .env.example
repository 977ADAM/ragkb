# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.

MARIADB_ROOT_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Одно и то же имя хоста во всех переменных ниже (KEYCLOAK_HOSTNAME,
# KEYCLOAK_HOSTNAME_URL, KEYCLOAK_ISSUER_URL) — это условие развёртывания:
# имя должно резолвиться в адрес хоста через корпоративный DNS или запись
# в /etc/hosts, иначе браузер не попадёт в Keycloak.
# KEYCLOAK_HOSTNAME — голое имя, используется как алиас в сети compose.
KEYCLOAK_HOSTNAME=kb.example.local
# KEYCLOAK_HOSTNAME_URL — то же имя, но с явной схемой и портом: значение
# идёт в KC_HOSTNAME (hostname v2), и без явного порта Keycloak подразумевает
# стандартные 443/80, а не 8443 — issuer в токене разойдётся с
# KEYCLOAK_ISSUER_URL.
KEYCLOAK_HOSTNAME_URL=https://kb.example.local:8443
KEYCLOAK_ISSUER_URL=https://kb.example.local:8443/realms/company

# Каталог ./certs монтируется в Keycloak и должен содержать:
#   tls.crt, tls.key — серверный сертификат (внутренний УЦ или самоподписанный)
#   ca.crt           — корневой сертификат этого УЦ (если Angie/браузер
#                       проверяют цепочку Keycloak)

# Локальный compose без Angie: логин и группы для BFF. На сервере не задавать —
# заголовки X-Forwarded-* ставит Angie.
# RAGKB_DEV_USER=dev
# RAGKB_DEV_GROUPS=ragkb-users,ragkb-admins

# --- LLM: любой OpenAI-совместимый HTTP (обычно корень …/v1) ---
# RAGKB_LLM_URL=http://10.10.1.114:8080/v1
# RAGKB_LLM_MODEL=qwen2.5-instruct
# RAGKB_LLM_API_KEY=
# RAGKB_LLM_BACKEND=openai
#
# Эмбеддинги — HuggingFace в контейнере rag (не llama.cpp на :8080).
# RAGKB_EMBEDDING_BACKEND=sentence-transformers
# RAGKB_EMBEDDING_MODEL=BAAI/bge-m3

# Журналы процесса rag (файлы app.log / errors.log). Пустой RAGKB_LOG_DIR — только stdout.
# RAGKB_LOG_LEVEL=INFO
# RAGKB_LOG_DIR=data/logs
