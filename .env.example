# Обязательные для `docker compose up` (make up). Для локального запуска можно использовать SQLite.
POSTGRES_USER=ragkb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragkb
# Хост БД в compose — имя сервиса.
POSTGRES_HOST=postgres

# Эмбеддинги считает Ollama на хосте — модель в образ rag не входит.
# Перед первым запуском: ollama pull qwen3-embedding:0.6b
# host.docker.internal — хост-машина из контейнера (extra_hosts уже задан).
RAGKB_EMBEDDING_BACKEND=ollama
RAGKB_EMBEDDING_MODEL=qwen3-embedding:0.6b
RAGKB_EMBEDDING_URL=http://host.docker.internal:11434
# Держать модель загруженной между индексацией и вопросами.
RAGKB_EMBEDDING_KEEP_ALIVE=30m

# Генерация — обязательна: OpenAI-совместимый HTTP (vLLM, llama.cpp, LM Studio…).
# Подойдёт и сама Ollama: укажите её корень с /v1.
# Без адреса и модели POST /api/v1/ask отвечает 503, экстрактивного ответа нет.
RAGKB_LLM_URL=http://127.0.0.1:11434/v1
RAGKB_LLM_MODEL=qwen2.5:7b-instruct
