# Адрес FastAPI-бэкенда. Браузер его не знает — ходит только в BFF SvelteKit.
RAGKB_BACKEND_URL=http://127.0.0.1:8000

# Ограничение скачивания оригиналов на BFF. Счётчики считаются по адресу
# клиента и живут в памяти одного процесса frontend: при нескольких репликах
# нужен общий ограничитель или ограничение на внешнем прокси.
RAGKB_DOWNLOAD_RATE_PER_MINUTE=10
RAGKB_DOWNLOAD_BURST=3
RAGKB_DOWNLOAD_MAX_CONCURRENT=2
RAGKB_DOWNLOAD_MAX_KEYS=10000

# Адрес клиента BFF берёт из соединения; заголовок читает сам адаптер
# SvelteKit, если задан ADDRESS_HEADER. Задавать его (вместе с XFF_DEPTH) можно
# только когда прямой доступ к порту frontend закрыт, а заголовок перезаписывает
# доверенный прокси: иначе посетитель подставит любой адрес и обойдёт лимит.
#
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
