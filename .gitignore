ragkb.egg-info

.venv

# Артефакты сборки индекса и сам корпус: у каждой установки свои документы
data/index/
data/docs/

# Переписка пользователей — не должна попадать в репозиторий.
# data/history/ — подкаталог для тома с базой диалогов в Docker
# (RAGKB_HISTORY_PATH=/app/data/history/history.sqlite3, см. docker-compose.yml).
data/*.sqlite3*
# Настройки со страницы управления: у каждой установки свои
data/settings.json
data/history/

# Журналы приложения (rotate в data/logs)
data/logs/
backend/logs/
backend/data/

.worktrees/

.mypy_cache/
.ruff_cache/
__pycache__/
*.pyc

.DS_Store

# Секреты развёртывания и сертификаты контура
.env
certs/

# Бэкапы sed -i '' на macOS (пустой суффикс из-за особенностей BSD sed)
*-e

node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
